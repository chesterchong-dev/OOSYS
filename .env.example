# Copy to .env for local development; never commit real secrets.
OOSYS_ENVIRONMENT=development
OOSYS_DATABASE_URL=postgresql+psycopg://oosys:change-me@localhost:5432/oosys
OOSYS_API_PREFIX=/api/v1
OOSYS_ALLOW_SELF_REGISTRATION=false
OOSYS_SESSION_TTL_HOURS=12
OOSYS_LOGIN_MAX_ATTEMPTS=8
OOSYS_LOGIN_WINDOW_MINUTES=15
