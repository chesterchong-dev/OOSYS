# Copy to .env for local development; never commit real secrets.
OOSYS_ENVIRONMENT=development
OOSYS_DATABASE_URL=postgresql+psycopg://oosys:change-me@localhost:5432/oosys
OOSYS_API_PREFIX=/api/v1
OOSYS_ALLOW_SELF_REGISTRATION=false
OOSYS_SESSION_TTL_HOURS=12
OOSYS_LOGIN_MAX_ATTEMPTS=8
OOSYS_LOGIN_WINDOW_MINUTES=15


# SMTP delivery for password recovery and invitations
OOSYS_SMTP_HOST=
OOSYS_SMTP_PORT=587
OOSYS_SMTP_USERNAME=
OOSYS_SMTP_PASSWORD=
OOSYS_EMAIL_FROM=
OOSYS_PASSWORD_RESET_URL=
OOSYS_INVITATION_ACCEPT_URL=

# Required in production: random, high-entropy secret shared by all app instances for keyed rate-limit identifiers
OOSYS_LOGIN_RATE_LIMIT_SECRET=
